{
  "_doc": "Forgot-password validation (ForgotPasswordPage: send needs a valid phone; reset needs a 6-digit code + password >= 8 + matching confirm). Buttons are never disabled for validation (2026-07-12); an invalid submit surfaces the forgot-error Alert and stays on the step. Every run uses a throwaway phone so no reset can ever succeed. 'valid' rows are asserted enabled but never clicked.",
  "meta": { "passwordMin": 8, "codeLength": 6 },
  "sendCases": [
    { "id": "send-phone-empty", "technique": "ECP", "fields": { "phone": "" }, "valid": false, "note": "empty phone" },
    { "id": "send-phone-short", "technique": "ECP", "fields": { "phone": "123" }, "valid": false, "note": "too-short phone" },
    { "id": "send-phone-valid", "technique": "ECP", "fields": { "phone": "__UNIQUE_PHONE__" }, "valid": true, "note": "throwaway valid phone (generated per run)" }
  ],
  "resetCases": [
    { "id": "code-bva-5", "technique": "BVA", "target": "code", "fields": { "code": "12345", "password": "12345678", "confirm": "12345678" }, "valid": false, "note": "code length 5 = required 6 − 1" },
    { "id": "password-bva-7", "technique": "BVA", "target": "password", "fields": { "code": "123456", "password": "1234567", "confirm": "1234567" }, "valid": false, "note": "password length 7 = minimum 8 − 1" },
    { "id": "password-ecp-mismatch", "technique": "ECP", "target": "confirm", "fields": { "code": "123456", "password": "12345678", "confirm": "12345679" }, "valid": false, "note": "boundary-length passwords but mismatched" },
    { "id": "all-bva-boundary", "technique": "BVA", "target": "all", "fields": { "code": "123456", "password": "12345678", "confirm": "12345678" }, "valid": true, "note": "6-digit code + matching 8-char passwords (never clicked)" }
  ],
  "codeInputCases": [
    { "id": "code-strip-letters", "technique": "error-guessing", "type": "12ab", "expectValue": "12", "note": "non-digits stripped by the input transform" },
    { "id": "code-clamp-7", "technique": "BVA", "type": "1234567", "expectValue": "123456", "note": "7th digit clamped by maxLength 6" }
  ]
}
