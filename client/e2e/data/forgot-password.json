{
  "_doc": "Forgot-password reset gating (ForgotPasswordPage: canReset = code is 6 digits && password >= 10 && confirm >= 10 && !mismatch; send gated on isValidGeorgianPhone). Driven by e2e/data-driven/forgot-password.spec.ts. Every run uses a throwaway phone so no reset can ever succeed. 'valid' = the gated button is enabled; forgot-submit is never clicked.",
  "meta": { "passwordMin": 10, "codeLength": 6 },
  "sendCases": [
    { "id": "send-phone-empty", "technique": "ECP", "fields": { "phone": "" }, "valid": false, "note": "empty phone" },
    { "id": "send-phone-short", "technique": "ECP", "fields": { "phone": "123" }, "valid": false, "note": "too-short phone" },
    { "id": "send-phone-valid", "technique": "ECP", "fields": { "phone": "__UNIQUE_PHONE__" }, "valid": true, "note": "throwaway valid phone (generated per run)" }
  ],
  "resetCases": [
    { "id": "code-bva-5", "technique": "BVA", "target": "code", "fields": { "code": "12345", "password": "1234567890", "confirm": "1234567890" }, "valid": false, "note": "code length 5 = required 6 − 1" },
    { "id": "password-bva-9", "technique": "BVA", "target": "password", "fields": { "code": "123456", "password": "123456789", "confirm": "123456789" }, "valid": false, "note": "password length 9 = minimum 10 − 1" },
    { "id": "password-ecp-mismatch", "technique": "ECP", "target": "confirm", "fields": { "code": "123456", "password": "1234567890", "confirm": "1234567899" }, "valid": false, "note": "boundary-length passwords but mismatched" },
    { "id": "all-bva-boundary", "technique": "BVA", "target": "all", "fields": { "code": "123456", "password": "1234567890", "confirm": "1234567890" }, "valid": true, "note": "6-digit code + matching 10-char passwords (never clicked)" }
  ],
  "codeInputCases": [
    { "id": "code-strip-letters", "technique": "error-guessing", "type": "12ab", "expectValue": "12", "note": "non-digits stripped by the input transform" },
    { "id": "code-clamp-7", "technique": "BVA", "type": "1234567", "expectValue": "123456", "note": "7th digit clamped by maxLength 6" }
  ]
}
