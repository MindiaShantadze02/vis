{
  // Live Server serves demos/*.html on :5500 and reloads on ANY workspace file
  // change. The widget iframe updates itself via Vite HMR, so host-page reloads
  // for app-code changes are pure noise — and e2e runs (client/test-results/)
  // were reloading the demo every few seconds. Only demo-page edits should reload.
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    "**/.git/**",
    "**/node_modules/**",
    "client/**",
    "supabase/**",
    "docs/**",
    "demos/**/*.png",
    "**/*.log"
  ]
}
